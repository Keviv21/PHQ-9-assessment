GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
PORT=4174
DATABASE_URL=
# Set when using the shared dev database; the app/importer reject other databases.
ASSESSMENT_DATABASE_NAME=sagar prototype
# Private managed file archive (default: local-data/assessment-assets)
ASSESSMENT_ASSET_ROOT=
# Optional runtime JSON used only when the database library has not been imported.
ASSESSMENT_LIBRARY_FILE=data/assessment-library.json
# Development only; never implies clinical approval.
ASSESSMENT_DRAFT_SCORES=false
# Installed Chromium executable for PDF generation.
REPORT_CHROMIUM_PATH=
