GEMINI_API_KEY=
GEMINI_RECOMMENDATION_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
PORT=4174

# PostgreSQL shared storage. Keep the real credentials in your ignored .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
DATABASE_SCHEMA=chandrika
# Optional offline tests only: unset DATABASE_URL before setting DB_PATH.
# DB_PATH=data/prototype.sqlite
