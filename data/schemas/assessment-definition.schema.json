{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmind.local/schemas/assessment-definition.schema.json",
  "title": "Canonical assessment definition",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "versionId",
    "title",
    "description",
    "administration",
    "referencePeriod",
    "language",
    "metadata",
    "questions",
    "rules",
    "reporting",
    "references",
    "verification",
    "provenance",
    "exceptionReport"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "versionId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "administration": { "type": "string" },
    "referencePeriod": { "type": "object" },
    "language": { "type": "string", "minLength": 2 },
    "metadata": { "type": "object" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "text", "responseType", "options"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 },
          "responseType": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "score": { "type": ["number", "null"] },
                "printed_value": { "type": ["number", "string", "null"] }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "method", "item_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "minLength": 1 },
          "item_ids": { "type": "array", "items": { "type": "string" } },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "severity_bands": { "type": "array" }
        }
      }
    },
    "sections": { "type": "array" },
    "tables": { "type": "array" },
    "reporting": {
      "type": "object",
      "required": ["metrics", "charts", "interpretation", "coverage", "reportPlan"]
    },
    "references": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "object" },
    "provenance": {
      "type": "object",
      "required": ["access", "sourceDocuments", "sampleReport"]
    },
    "exceptionReport": {
      "type": "object",
      "required": [
        "missingScoringRules",
        "imageOnlyTables",
        "ambiguousSourceSections",
        "manualReview"
      ],
      "properties": {
        "missingScoringRules": { "type": "array" },
        "imageOnlyTables": { "type": "array" },
        "ambiguousSourceSections": { "type": "array" },
        "manualReview": { "type": "array" }
      }
    }
  }
}
