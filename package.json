{
  "name": "pod-assessment-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "import:assessments": "node scripts/assessments/import-catalogue.mjs",
    "audit:assessments": "node scripts/legacy/audit-assessment-bundle.mjs",
    "smoke:live": "node scripts/legacy/smoke-draft-live.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/database/migrate-sqlite.mjs",
    "import:legacy": "node scripts/legacy/import-assessment-bundle.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/database/backup-patients.mjs",
    "reports:install-browser": "playwright-core install chromium",
    "reports:preview": "node scripts/assessments/preview-report.mjs",
    "reports:validate": "node scripts/assessments/validate-reporting.mjs"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "pg": "^8.23.1",
    "playwright-core": "1.59.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
