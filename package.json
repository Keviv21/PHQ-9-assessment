    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.js",
    "test": "node --test test/*.test.js",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-database.mjs",
    "db:inspect": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/inspect-database.mjs",
    "db:smoke": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-postgres.mjs",
    "db:smoke:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-postgres-api.mjs",
    "import:assessments": "node scripts/import-assessment-bundle.mjs",
    "audit:assessments": "node scripts/audit-assessment-bundle.mjs",
