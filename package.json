{
  "name": "phq9-gemini-live-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.js",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.js",
    "test": "node --test",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-database.mjs",
    "db:inspect": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/inspect-database.mjs",
    "db:smoke": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-postgres.mjs",
    "db:smoke:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-postgres-api.mjs",
    "import:assessments": "node scripts/import-assessment-bundle.mjs",
    "audit:assessments": "node scripts/audit-assessment-bundle.mjs",
    "audit:new": "node scripts/audit-new-bundle.mjs",
    "import:new": "node scripts/import-new-bundle.mjs",
    "check:definitions": "node scripts/check-definition-coverage.mjs",
    "inspect:definition": "node scripts/inspect-definition.mjs",
    "db:smoke:definitions": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-definitions-postgres.mjs",
    "db:demo:definition": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/demo-definition-assignment.mjs",
    "db:inspect:definition": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/inspect-definition-record.mjs",
    "seed:analytics": "node scripts/seed-analytics-demo.mjs",
    "demo:analytics": "node --env-file-if-exists=.env scripts/run-analytics-demo.mjs",
    "smoke:live": "node scripts/smoke-draft-live.mjs",
    "smoke:doctor": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-doctor-chat.mjs",
    "smoke:definition-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-definition-live.mjs",
    "library:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-library.mjs"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "pg": "^8.23.1",
    "ws": "8.22.1",
    "playwright-core": "1.59.1"
  }
}
